# Copiare in keystore.properties nella radice del progetto (ignorato da Git).
# Compilare solo localmente: non inviare password o chiave in chat.
# Usare / nei percorsi Windows; un eventuale carattere backslash nei valori
# deve essere raddoppiato secondo il formato Java Properties.
storeFile=C:/Users/NOME_UTENTE/MediShelfSigning/medishelf-app-signing.jks
storePassword=
keyAlias=medishelf-app
keyPassword=
